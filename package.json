{
  "name": "@uniform/design",
  "version": "0.1.6",
  "description": "Uniform design system: tokens, brand assets, waves, CSS components",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "files": [
    "dist",
    "NOTICE",
    "LICENSE-BRAND"
  ],
  "exports": {
    "./design.css": "./dist/design.css",
    "./tokens.css": "./dist/tokens.css",
    "./vars.css": "./dist/vars.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./waves": {
      "types": "./dist/waves.d.ts",
      "default": "./dist/waves.js"
    },
    "./manifest.json": "./dist/manifest.json",
    "./*": "./dist/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "check": "prettier --check . && node build/build.mjs --check && node scripts/contrast.mjs && node scripts/forbidden.mjs && node scripts/svg-colors.mjs && node scripts/waves-guard.mjs",
    "test:a11y": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  }
}
