{
  "name": "@uniform/design",
  "version": "0.2.2",
  "description": "Uniform design system: tokens, brand assets, CSS components",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "files": [
    "dist",
    "NOTICE",
    "LICENSE-BRAND"
  ],
  "exports": {
    "./design.css": "./dist/design.css",
    "./tokens.css": "./dist/tokens.css",
    "./vars.css": "./dist/vars.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./waves": {
      "types": "./dist/waves.d.ts",
      "default": "./dist/waves.js"
    },
    "./manifest.json": "./dist/manifest.json",
    "./*": "./dist/*",
    "./catalog.json": "./dist/catalog.json",
    "./interactions": "./dist/interactions.js",
    "./agent-api": "./dist/agent-api.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "check": "prettier --check . && node build/build.mjs --check && node scripts/contrast.mjs && node scripts/forbidden.mjs && node scripts/svg-colors.mjs && node scripts/waves-guard.mjs && npm run test:contracts && npm run check:budgets",
    "test:a11y": "playwright test",
    "test:contracts": "node build/site.mjs && node --test tests/unit/*.test.mjs",
    "check:budgets": "node scripts/budgets.mjs",
    "design": "node scripts/design.mjs",
    "lint:design": "node scripts/lint-design.mjs",
    "render:share": "node scripts/render-share.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "leaflet": "1.9.4",
    "prettier": "3.9.9"
  }
}
